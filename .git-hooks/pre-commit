#!/bin/bash
# Gatekeeper main branch protection
# core.hooksPath = .git-hooks  → 此 hook 对所有 worktree 生效
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$BRANCH" = "main" ]; then
  cat >&2 << 'EOF'
========================================
  GATEKEEPER: main branch is PROTECTED
========================================
  Direct commits to 'main' are blocked.
  Use a feature worktree: git worktree add -b feature/spz-gatekeeper-2.0.2-r<N> ...
  All changes through PR workflow.
  Emergency bypass: SKIP_GATEKEEPER_HOOK=1 git commit ...
========================================
EOF
  exit 1
fi
exit 0
